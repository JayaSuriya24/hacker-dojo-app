# ---------------------------------------------------------------------------
# Hacker Dojo mobile — build-time environment
#
# Copy to `mobile/.env` for local development. On EAS these come from the build
# profile in `eas.json` and from EAS secrets.
#
# EVERYTHING HERE IS PUBLIC. Values prefixed EXPO_PUBLIC_ are compiled into the
# JavaScript bundle and can be read out of any installed app. Never put a
# Supabase service-role key or a Stripe SECRET key in this file — those live on
# the server (see server/.env.example).
# ---------------------------------------------------------------------------

# 'development' | 'preview' | 'production' — drives the bundle id suffix and
# the display name, so all three can be installed side by side.
APP_VARIANT=development

# The Express API. Use your machine's LAN IP (not localhost) when running on a
# physical device — localhost on the phone means the phone.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Supabase. The ANON key is designed to be public; Row Level Security is what
# protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Sign in with Apple. Build-time switch, NOT a secret — it only says whether the
# Supabase Apple provider is configured. Leave unset (or anything but `true`) and
# the Apple button is not rendered, which is correct while the provider is off:
# a button backed by an unconfigured provider fails with invalid_client after the
# member has already committed to it.
#
# REQUIRED for an iOS App Store release: guideline 4.8 requires Sign in with
# Apple wherever another social login is offered, and Google is offered.
# Turn on together with `[auth.external.apple]` in supabase/config.toml.
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false

# Stripe PUBLISHABLE key (pk_...). The secret key is server-side only.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# EAS project id — for OTA updates and push notifications. NOT a secret: it
# ships in the bundle and appears in updates.url.
#
# Leave EMPTY here. It must come from the EAS environment (`eas env:create
# --name EAS_PROJECT_ID --value <id> --visibility plaintext`, or the dashboard)
# so every build profile receives it during an EAS build.
#
# Do NOT put a placeholder UUID here. The zero UUID this file used to carry is a
# well-formed id, so it satisfied every fallback in app.config.ts while pointing
# at a project that does not exist — push tokens failed and OTA was dead, both
# silently. `app.config.ts` now REFUSES to build for production or on EAS unless
# this resolves to a real id.
#
# Find it with `eas project:info`, or on expo.dev under the project's settings.
EAS_PROJECT_ID=
