# ---------------------------------------------------------------------------
# Hacker Dojo API — server environment
#
# Copy to `server/.env` and fill in. The process refuses to start if anything
# here is missing or malformed (see src/config/env.ts).
#
# NOTHING in this file belongs in the mobile app. The service-role key and the
# Stripe secret key grant full data and full charge access respectively.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated. Required in production — there is no wildcard fallback.
CORS_ORIGINS=http://localhost:8081,https://app.hackerdojo.org

# Supabase --------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Safe to ship to clients; used here only to verify a caller's JWT.
SUPABASE_ANON_KEY=eyJhbGciOi...
# BYPASSES ROW LEVEL SECURITY. Server only, never in a mobile build, never in git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Stripe ----------------------------------------------------------------------
# Server only. The mobile app gets the PUBLISHABLE key, which is a different value.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the Dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Where Stripe returns a member after the Billing Portal. A deep link into the
# app, so cancelling a plan does not strand someone in a browser. Must be https
# in production.
BILLING_PORTAL_RETURN_URL=https://app.hackerdojo.org/settings

# NOTE: memberships are real Stripe Subscriptions. Each plan row in the `plans`
# table needs `stripe_price_monthly` (and `stripe_price_annual` where offered)
# set to a Price id from your Stripe account — see the seed file. A plan with no
# Price id cannot be checked out, deliberately: the alternative is a one-off
# charge that never renews, which is what this replaced.

# Push --------------------------------------------------------------------------
# Expo access token, from `eas whoami` / expo.dev → Account → Access Tokens.
# REQUIRED in production: without it the notification service records deliveries
# and sends nothing, so booking reminders and the digest would silently no-op.
EXPO_ACCESS_TOKEN=

# Policy ----------------------------------------------------------------------
# Ceiling on a single in-app donation, in cents. Larger gifts go through staff.
MAX_DONATION_CENTS=2000000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Number of proxy hops to trust for client IP. 1 behind a single load balancer.
TRUST_PROXY_HOPS=1

# Upload ceilings, in bytes. These mirror the Supabase bucket limits — raising
# one without raising the other produces an upload that passes validation and
# then fails in storage.
MAX_AVATAR_BYTES=2097152
MAX_DOCUMENT_BYTES=20971520

# Background work -----------------------------------------------------------
# Occupancy sampling, booking and membership reminders, the weekly digest.
# The scheduler is NOT distributed: set this to `true` on exactly ONE instance.
# Two replicas both running it would double every sample and every send.
RUN_SCHEDULER=true
# How often live sessions are rolled up into `occupancy_samples`.
OCCUPANCY_SAMPLE_INTERVAL_MS=60000

# Printed on donation receipts.
DOJO_EIN=26-4812213
